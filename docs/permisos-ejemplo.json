// EJEMPLO. No esta activo. Para aplicarlo, copia su contenido (sin estos
// comentarios, porque JSON no admite comentarios) a .claude/settings.json
// en la raiz de este repositorio:
//
//     cp docs/permisos-ejemplo.json .claude/settings.json
//     # y borra a mano las lineas que empiezan por //
//
// Que hace:
//
//   "allow"  Las once herramientas son lectura y aritmetica: ninguna puede
//            enviar una orden. Permitirlas te evita una confirmacion por cada
//            comando durante la sesion, cuando vas con prisa.
//
//   "ask"    TODA herramienta de tu broker que coloque, cambie, cancele o
//            cierre algo. Esta es la linea que te protege de verdad: hace
//            que aparezca la tarjeta "Allow once / Deny" cada vez.
//            NUNCA muevas una de estas a "allow". Ni una.
//
//   "deny"   El registro de tus operaciones, los .env y el archivo de
//            configuracion de Claude Desktop (donde viven tus claves API):
//            Claude no necesita leerlos nunca.
{
  "permissions": {
    "allow": [
      "Bash(bin/trader:*)",
      "Bash(python3 .claude/skills/trader-scanner/scan.py:*)",
      "Bash(python3 .claude/skills/trader-news/news.py:*)",
      "Bash(python3 .claude/skills/trader-entry/entry.py:*)",
      "Bash(python3 .claude/skills/trader-exit/exit.py:*)",
      "Bash(python3 .claude/skills/trader-timemachine/timemachine.py:*)",
      "Bash(python3 .claude/skills/trader-budget/size.py:*)",
      "Bash(python3 .claude/skills/trader-risk/check.py:*)",
      "Bash(python3 .claude/skills/trader-broker/ticket.py:*)",
      "Bash(python3 .claude/skills/trader-alerts/alerts.py:*)",
      "Bash(python3 .claude/skills/trader-analyst/facts.py:*)",
      "Bash(python3 .claude/skills/trader-pelosi/ptr.py:*)",
      "Bash(python3 -m unittest:*)"
    ],
    "ask": [
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__place_crypto_order",
      "mcp__alpaca__cancel_order_by_id",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__close_position",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__update_account_config",
      "mcp__alpaca__exercise_options_position",
      "mcp__alpaca__do_not_exercise_options_position"
    ],
    "deny": [
      "Read(./trader/state/**)",
      "Read(**/.env)",
      "Read(**/claude_desktop_config.json)"
    ]
  }
}
